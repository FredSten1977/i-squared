# I-Squared Statsbygg – miljøvariabler
#
# PRODUKSJON (Supabase) bruker IKKE .env:
#   - Administrator-PIN settes i Supabase SQL Editor:  select public.isq_set_admin_pin('din-pin');
#   - Edge Function får SUPABASE_URL og SUPABASE_SERVICE_ROLE_KEY automatisk fra Supabase.
#   - Nettleseren bruker bare adressen og den publiserbare nøkkelen i site.config.json.
#
# LOKAL UTVIKLING (npm run dev):
ISQ_ADMIN_PIN=123456
PORT=8787
# Playwright-nettlesere (valgfritt, hvis de ligger et annet sted enn standard):
# PLAYWRIGHT_BROWSERS_PATH=
